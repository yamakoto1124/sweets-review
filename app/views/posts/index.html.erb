<h2>レビュー一覧</h2>


<!-- ログイン中なら新規投稿ボタンを表示 -->
<div style="margin: 20px 0;">
  <% if authenticated? %>
    <%= link_to "＋ レビューを投稿する", new_post_path, style: "padding: 10px 15px; background: #ff9900; color: white; text-decoration: none; border-radius: 4px; font-weight: bold;" %>
  <% else %>
    <%= link_to "ログインしてレビューを投稿する", new_session_path, style: "padding: 10px 15px; background: #666; color: white; text-decoration: none; border-radius: 4px;" %>
  <% end %>
</div>

<% if @posts.any? %>
  <div style="display: flex; flex-direction: column; gap: 15px;">
    <% @posts.each do |post| %>
      <div style="border: 1px solid #ddd; padding: 15px; border-radius: 6px; background-color: #fafafa;">
        <!-- タイトル（詳細画面へ） -->
        <h3 style="margin-top: 0;">
          <%= link_to post.title, post_path(post), style: "color: #005333; text-decoration: underline;" %>
        </h3>

        <!-- 投稿者名と投稿日時 -->
        <p style="font-size: 0.9em; color: #666;">
          投稿者: <%= link_to "#{post.user.last_name} #{post.user.first_name}", user_path(post.user), style: "color: #0066cc; text-decoration: underline;" %> |
          投稿日: <%= post.created_at.strftime("%Y/%m/%d %H:%M") %>
        </p>

        <!-- 本文の冒頭50文字 -->
        <p style="color: #444;">
          <%= truncate(post.body, length: 50) %>
        </p>

        <div>
          <%= link_to "続きを読む", post_path(post), style: "font-size: 0.9em; color: #0066cc;" %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p>まだ投稿されたレビューはありません。</p>
<% end %>

<div style="margin-top: 20px;">
  <%= link_to "← ホームに戻る", root_path, style: "color: #666; text-decoration: underline;" %>
</div>
