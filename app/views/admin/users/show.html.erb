<div class="container mt-4">
  <h2 class="mb-4"><%= @user.last_name %> <%= @user.first_name %> さんの会員詳細</h2>

  <% if flash[:notice] %>
    <div class="alert alert-success"><%= flash[:notice] %></div>
  <% end %>

  <table class="table table-bordered" style="max-width: 600px;">
    <tr>
      <th>会員ID</th>
      <td><%= @user.id %></td>
    </tr>
    <tr>
      <th>氏名</th>
      <td><%= @user.last_name %> <%= @user.first_name %></td>
    </tr>
    <tr>
      <th>メールアドレス</th>
      <td><%= @user.email_address %></td>
    </tr>
    <tr>
      <th>会員ステータス</th>
      <td>
        <% if @user.is_deleted %>
          <span class="text-secondary fw-bold">退会</span>
        <% else %>
          <span class="text-success fw-bold">有効</span>
        <% end %>
      </td>
    </tr>
  </table>

  <div class="mt-3 d-flex gap-2">
    <%= link_to "会員一覧へ戻る", admin_users_path, class: "btn btn-secondary" %>

    <% unless @user.is_deleted %>
      <%= button_to "退会させる", admin_user_path(@user), method: :patch, data: { turbo_confirm: "本当にこの会員を退会させますか？" }, class: "btn btn-danger" %>
    <% end %>
  </div>
</div>