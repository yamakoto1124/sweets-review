<div class="container mt-4">
  <% if @range == "User" %>
    <h2>Users search for "<%= @word %>"</h2>
    <table class="table table-hover">
      <thead>
        <tr>
          <th>名前</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td><%= user.last_name %> <%= user.first_name %></td>
            <td><%= link_to "詳細", user_path(user) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <h2>Posts search for "<%= @word %>"</h2>
    <table class="table table-hover">
      <thead>
        <tr>
          <th>タイトル</th>
          <th>感想</th>
        </tr>
      </thead>
      <tbody>
        <% @posts.each do |post| %>
          <tr>
            <td><%= link_to post.title, post_path(post) %></td>
            <td><%= post.body %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
